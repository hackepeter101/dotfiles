{
    "layer": "top",
    "position": "top",
    "height": 22, // Sehr schmal, nimmt keinen Platz weg
    // --- Layout ---
    "modules-left": [
        "cpu",
        "memory",
        "temperature",
        "custom/Zimmertemperatur-sensor"
    ],
    "modules-center": [
        "mpris",
        "hyprland/workspaces"
    ],
    "modules-right": [
        "tray",
        "clock",
        "custom/notification"
    ],
    // --- Module Links ---
    "cpu": {
        "format": "CPU {usage:2}%",
        "interval": 2
    },
    "memory": {
        "format": "RAM {percentage:2}%",
        "interval": 2
    },
    "temperature": {
        "format": "TMP {temperatureC}°C",
        "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input" // Ggf. anpassen, falls er nichts anzeigt
    },
    "custom/Zimmertemperatur-sensor": {
    "exec": "source ~/.config/waybar/secrets.sh && curl -s -H \"Authorization: Bearer $HA_TOKEN\" http://homeassistant.local:8123/api/states/sensor.esphome_web_757cb4_zimmer_temperatur | jq -r '.state | tonumber | (. * 10 | round) / 10'",
        "interval": 60,
        "format": " 󰽔 {}  ",
        "tooltip": false
    },

    // --- Module Mitte ---
    "mpris": {
        "format": "{status_icon} {title} - {artist}",
        "status-icons": {
            "playing": "[⏸]",
            "paused": "[▶]"
        },
        "max-length": 40
    },
    "hyprland/workspaces": {
        "all-outputs": false, // Zeigt Workspaces NUR auf dem Bildschirm, wo sie auch sind
        "format": "[{name}]", // Eckige Klammern für den Terminal-Look
        "on-click": "activate",
        "disable-scroll": true
    },
    // --- Module Rechts ---
    "tray": {
        "spacing": 8
    },
    "clock": {
        "format": "{:%H:%M:%S}", // Mit Sekunden für den aktiven "Live"-Vibe
        "interval": 1
    },
    "custom/notification": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂜",
            "dnd-notification": "󰂠",
            "dnd-none": "󰪓",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰪑",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    }
}