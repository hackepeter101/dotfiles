# --- Mako Stealth/Cyberpunk Theme ---

# Position & Layout
layer=overlay
anchor=top-right
margin=20
width=350
height=150
max-visible=3

# Appearance
background-color=#0a0a0ff0
text-color=#E0E0E0
font=Maple Mono 11
    
# Borders
border-size=2
border-color=#00FFCC60
border-radius=8

# Padding & Behavior
padding=15
default-timeout=5000
ignore-timeout=1
    
# Urgency Levels
[urgency=low]
border-color=#00FFCC30

[urgency=normal]
border-color=#00FFCC60

[urgency=critical]
border-color=#FF003C90
default-timeout=0