{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  

  "logo": {
    "source": "~/.config/fastfetch/Samurai.png",
    "type": "kitty-direct",
    "width": 50
  },

  
  "display": {
    "color": {
      "keys": "magenta", // Farbe der Labels auf der linken Seite (OS, Kernel, etc.)
      "title": "magenta"     // Farbe des Titels (user@host)
    }
  },

  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "keyColor": "yellow" // Überschreibt die globale 'keys'-Farbe nur für das OS-Modul
    },
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}