configuration {
    modes: [ drun, run, window ];
    terminal: "kitty";
    font: "Maple Mono 11";
    location: 0;
    lines: 8;
    show-icons: true;
    fixed-num-lines: true;
    case-sensitive: false;
}

* {
    bg: #050209ff;
    panel: #0d0a16f2;
    fg: #c4ede9ff;
    muted: #595c61ff;
    accent: #e41148ff;
    foreground: @fg;
    text: @fg;
    background: @bg;
}

window {
    width: 38%;
    padding: 12px;
    background-color: @bg;
    border: 1px;
    border-color: @accent;
}

mainbox {
    spacing: 8px;
    padding: 0px;
}

inputbar {
    padding: 8px 10px;
    spacing: 6px;
    background-color: @panel;
    text-color: @fg;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    text-color: @fg;
    cursor-color: @accent;
    placeholder: "Search";
    placeholder-color: @muted;
}

listview {
    padding: 0px;
    spacing: 2px;
    fixed-height: false;
    scrollbar: false;
    background-color: transparent;
}

element {
    padding: 8px 10px;
    border: 0px;
    background-color: @background;
    text-color: @fg;
}

element selected.normal {
    background-color: @accent;
    text-color: @bg;
}

element selected.urgent,
element urgent {
    background-color: @accent;
    text-color: @bg;
}

element alternate.normal {
    background-color: @background;
}

element-text {
    text-color: inherit;
}

element-icon {
    size: 1.2em;
}

message {
    padding: 8px 10px;
    background-color: @panel;
    border: 1px;
    border-color: @muted;
    text-color: @muted;
}

textbox {
    text-color: @fg;
}

case-indicator {
    text-color: @muted;
}

textbox-prompt-colon {
    str: "";
}
